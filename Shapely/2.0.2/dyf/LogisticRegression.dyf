    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n# Logistic Regression (Classification)\r\n\r\nimport sys\r\nimport numpy as np\r\n\r\ntry:\r\n    from sklearn.linear_model import LogisticRegression\r\n    from sklearn.model_selection import train_test_split        \r\nexcept ImportError:\r\n    raise Exception(\"Scikit-learn not found.\")\r\n\r\n# INPUTS\r\ntrain_x = IN[0]\r\ntrain_y = IN[1]\r\ntest_x = IN[2]\r\n\r\nif train_x and train_y and test_x:\r\n    try:\r\n        x_train = np.array(train_x)\r\n        y_train = np.array(train_y).flatten()\r\n        x_test = np.array(test_x)\r\n        \r\n        if x_test.ndim == 1:\r\n            x_test = x_test.reshape(1, -1)\r\n            \r\n        # Test Split\r\n        X_train, X_val, Y_train, Y_val = train_test_split(\r\n            x_train, y_train, \r\n            test_size=0.2, \r\n            shuffle=True, \r\n            random_state=42\r\n        )\r\n                \r\n        # Model\r\n        model = LogisticRegression(max_iter=1000, random_state=42, solver='lbfgs')\r\n        \r\n        # Fit\r\n        model.fit(X_train, Y_train)\r\n        \r\n        # Prediction\r\n        predictions = model.predict(x_test).tolist()\r\n        \r\n        # Score\r\n        probs = model.predict_proba(x_test)\r\n        score = [max(p) for p in probs]\r\n                \r\n        # OUTPUT\r\n        \r\n        OUT = [predictions, model, score]\r\n\r\n    except Exception as e:\r\n        OUT = [None, None, None, f\"Error: {str(e)}\"]\r\nelse:\r\n    OUT = [None, None, None, \"Waiting for Data...\"]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b459529972974486b23cabca3c21797f",
      "NodeType": "PythonScriptNode",
