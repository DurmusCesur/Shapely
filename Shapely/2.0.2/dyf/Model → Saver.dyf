    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n# Model Saver\r\n\r\nimport sys\r\nimport os\r\n\r\ntry:\r\n    import joblib\r\nexcept ImportError:\r\n    import pickle as joblib\r\n\r\n# Input\r\nmodel_input = IN[0]\r\nscaler_input = IN[1]\r\nencoder_input = IN[2]\r\nraw_path = IN[3]\r\n\r\nresult = \"\"\r\nmodel_to_save = None\r\n\r\nif hasattr(model_input, 'model'):\r\n    model_to_save = model_input.model\r\nelse:\r\n    model_to_save = model_input\r\n\r\nif model_to_save is None:\r\n    result = \"Error: Model input is Null.\"\r\nelif raw_path is None or raw_path == \"\":\r\n    result = \"Error: Invalid File Path.\"\r\nelse:\r\n    try:\r\n        file_path = os.path.normpath(raw_path)\r\n        \r\n        if os.path.isdir(file_path):\r\n            file_path = os.path.join(file_path, \"trained_model.pkl\")\r\n        elif not os.path.splitext(file_path)[1]:\r\n             file_path += \".pkl\"\r\n             \r\n        folder = os.path.dirname(file_path)\r\n        if folder and not os.path.exists(folder):\r\n            os.makedirs(folder)\r\n\r\n        bundle = {\r\n            \"model_object\": model_to_save,   \r\n            \"scaler_object\": scaler_input,   \r\n            \"encoder_object\": encoder_input, \r\n            \"meta_data\": \"Created with ML Package v1.0\"\r\n        }\r\n\r\n        joblib.dump(bundle, file_path)\r\n        \r\n        saved_components = [\"Model\"]\r\n        if scaler_input: saved_components.append(\"Scaler\")\r\n        if encoder_input: saved_components.append(\"Encoder\")\r\n        \r\n        result = f\"Success! Saved ({', '.join(saved_components)}) to: {file_path}\"\r\n\r\n    except Exception as e:\r\n        result = f\"Save Error: {str(e)}\"\r\n\r\n# OUTPUT\r\nOUT = result",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a76a7bc0f5c34607b02b30ec8a4b0b1a",
      "NodeType": "PythonScriptNode",
