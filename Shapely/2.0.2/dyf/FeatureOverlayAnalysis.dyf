      "Replication": "Disabled",
      "Description": "Un paramètre de fonction, utiliser avec des noeuds personnalisés.\r\n\r\nVous pouvez spécifier le type et la valeur par défaut du paramètre. Par exemple,\r\n\r\nentrée: var[]..[]\r\nvaleur: bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n# Superposed Visualization\r\n\r\nimport sys\r\nimport numpy as np\r\nimport tempfile\r\nimport os\r\nimport clr\r\nimport math\r\n\r\nclr.AddReference('System.Drawing')\r\nfrom System.Drawing import Bitmap, Graphics, Color, Pen, SolidBrush, Font, FontFamily, StringFormat, StringAlignment\r\nfrom System.Drawing.Drawing2D import SmoothingMode\r\nfrom System.Drawing.Imaging import ImageFormat\r\n\r\ntry:\r\n    from sklearn.preprocessing import MinMaxScaler, PolynomialFeatures\r\n    from sklearn.linear_model import LinearRegression\r\n    from sklearn.pipeline import make_pipeline\r\nexcept ImportError:\r\n    raise Exception(\"Sklearn not found.\")\r\n\r\n# Ploter\r\nclass NativeSuperPlotter:\r\n    def __init__(self, width=1000, height=600):\r\n        self.width = width\r\n        self.height = height\r\n        self.padding_left = 60\r\n        self.padding_bottom = 60\r\n        self.padding_top = 40\r\n        self.padding_right = 100\r\n        \r\n        self.bmp = Bitmap(width, height)\r\n        self.g = Graphics.FromImage(self.bmp)\r\n        self.g.Clear(Color.White)\r\n        self.g.SmoothingMode = SmoothingMode.AntiAlias\r\n        \r\n        # Panel\r\n        self.font_title = Font(FontFamily.GenericSansSerif, 12, 1) \r\n        self.font_label = Font(FontFamily.GenericSansSerif, 10)\r\n        self.pen_axis = Pen(Color.Black, 3)\r\n        self.pen_grid = Pen(Color.LightGray, 0)\r\n        self.pen_grid.DashStyle = 2\r\n        self.brush_text = SolidBrush(Color.Black)\r\n        \r\n        # Legend\r\n        self.legend_y_pos = self.padding_top + 0\r\n\r\n    def _get_rainbow_color(self, i, total):\r\n        if total == 0: return Color.Blue\r\n        hue = (float(i) / total) * 360.0\r\n        s = 1.0; v = 0.8\r\n        c = v * s\r\n        x = c * (1 - abs((hue / 60.0) % 2 - 1))\r\n        m = v - c\r\n        \r\n        if 0 <= hue < 60: r, g, b = c, x, 0\r\n        elif 60 <= hue < 120: r, g, b = x, c, 0\r\n        elif 120 <= hue < 180: r, g, b = 0, c, x\r\n        elif 180 <= hue < 240: r, g, b = 0, x, c\r\n        elif 240 <= hue < 300: r, g, b = x, 0, c\r\n        else: r, g, b = c, 0, x\r\n        \r\n        return Color.FromArgb(255, int((r+m)*255), int((g+m)*255), int((b+m)*255))\r\n\r\n    def _map(self, val, src_min, src_max, dst_min, dst_max):\r\n        if src_max == src_min: return dst_min\r\n        return (val - src_min) * (dst_max - dst_min) / (src_max - src_min) + dst_min\r\n\r\n    def draw_axes(self, y_min, y_max, title):\r\n        plot_w = self.width - self.padding_left - self.padding_right\r\n        plot_h = self.height - self.padding_top - self.padding_bottom\r\n        x0 = self.padding_left\r\n        y0 = self.padding_top\r\n        \r\n        self.g.DrawRectangle(self.pen_axis, x0, y0, plot_w, plot_h)\r\n        \r\n        # Title\r\n        fmt = StringFormat()\r\n        fmt.Alignment = StringAlignment.Center\r\n        self.g.DrawString(title, self.font_title, self.brush_text, self.width/2, 10, fmt)\r\n\r\n    def draw_series(self, x_scatter, y_scatter, x_line, y_line, idx, total_features, y_global_min, y_global_max):\r\n        plot_w = self.width - self.padding_left - self.padding_right\r\n        plot_h = self.height - self.padding_top - self.padding_bottom\r\n        x0 = self.padding_left\r\n        y0 = self.padding_top\r\n        \r\n        col = self._get_rainbow_color(idx, total_features)\r\n        pen_curve = Pen(col, 2)\r\n        pen_curve.DashStyle = 2\r\n        brush_pt = SolidBrush(Color.FromArgb(200, col.R, col.G, col.B))\r\n        \r\n        # Point\r\n        pt_size = 8\r\n        for x, y in zip(x_scatter, y_scatter):\r\n            px = x0 + (x * plot_w)\r\n            py = self._map(y, y_global_min, y_global_max, y0 + plot_h, y0)\r\n            \r\n            self.g.FillEllipse(brush_pt, px - pt_size/2, py - pt_size/2, pt_size, pt_size)\r\n\r\n        # Curve\r\n        for i in range(len(x_line) - 1):\r\n            px1 = x0 + (x_line[i] * plot_w)\r\n            py1 = self._map(y_line[i], y_global_min, y_global_max, y0 + plot_h, y0)\r\n            px2 = x0 + (x_line[i+1] * plot_w)\r\n            py2 = self._map(y_line[i+1], y_global_min, y_global_max, y0 + plot_h, y0)\r\n            \r\n            if y0 <= py1 <= y0 + plot_h and y0 <= py2 <= y0 + plot_h:\r\n                self.g.DrawLine(pen_curve, px1, py1, px2, py2)\r\n                \r\n        # Legend\r\n        leg_x = self.width - self.padding_right + 10\r\n        self.g.FillRectangle(SolidBrush(col), leg_x, self.legend_y_pos, 20, 10)\r\n        self.g.DrawString(f\"Feature {idx}\", self.font_label, self.brush_text, leg_x + 25, self.legend_y_pos - 2)\r\n        self.legend_y_pos += 20\r\n\r\n    def save(self, path):\r\n        self.bmp.Save(path, ImageFormat.Png)\r\n        self.g.Dispose()\r\n        self.bmp.Dispose()\r\n        return path\r\n\r\n# INPUTS\r\nX_in = IN[0]\r\ny_in = IN[1]\r\n\r\nif X_in and y_in:\r\n    try:\r\n        X = np.array(X_in)\r\n        y_temp = np.array(y_in)\r\n        \r\n        if y_temp.ndim > 1 and y_temp.shape[1] > 1:\r\n            y = np.argmax(y_temp, axis=1)\r\n        else:\r\n            y = y_temp.flatten()\r\n        \r\n        num_features = X.shape[1]\r\n        \r\n        # Normalize (MinMax)\r\n        scaler = MinMaxScaler()\r\n        X_scaled = scaler.fit_transform(X)\r\n        \r\n        y_min, y_max = y.min(), y.max()\r\n        margin = (y_max - y_min) * 0.1 if y_max != y_min else 1.0\r\n        y_min -= margin\r\n        y_max += margin\r\n        \r\n        plotter = NativeSuperPlotter(1000, 600)\r\n        plotter.draw_axes(y_min, y_max, \"Superposed Feature Analysis\")\r\n        \r\n        x_pred_range = np.linspace(0, 1, 100).reshape(-1, 1)\r\n        \r\n        for i in range(num_features):\r\n            x_col = X_scaled[:, i].reshape(-1, 1)\r\n            \r\n            # Model\r\n            model = make_pipeline(PolynomialFeatures(degree=2), LinearRegression())\r\n            model.fit(x_col, y)\r\n            y_pred_line = model.predict(x_pred_range)\r\n            \r\n            # Plotter\r\n            plotter.draw_series(\r\n                x_scatter=x_col.flatten(), \r\n                y_scatter=y, \r\n                x_line=x_pred_range.flatten(), \r\n                y_line=y_pred_line, \r\n                idx=i, \r\n                total_features=num_features,\r\n                y_global_min=y_min, \r\n                y_global_max=y_max\r\n            )\r\n            \r\n        # Save\r\n        temp_dir = tempfile.gettempdir()\r\n        file_name = \"Superposed_Analysis.png\"\r\n        path_out = os.path.join(temp_dir, file_name)\r\n        \r\n        if os.path.exists(path_out):\r\n            try: os.remove(path_out)\r\n            except: pass\r\n        \r\n        OUT = plotter.save(path_out)\r\n\r\n    except Exception as e:\r\n        OUT = f\"Error: {str(e)}\"\r\nelse:\r\n    OUT = \"No Data\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "d44d3009d4674ffaa32ed7c2ea44d853",
      "NodeType": "PythonScriptNode",
