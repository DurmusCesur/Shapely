    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n\r\nimport sys\r\nimport os\r\n\r\ntry:\r\n    import joblib\r\nexcept ImportError as e:\r\n    raise Exception(f\"Failed: {e}\")\r\n\r\n# INPUT\r\nfile_path = IN[0]\r\n\r\nloaded_model = None\r\nloaded_scaler = None\r\nloaded_encoder = None\r\nresult = \"\"\r\n\r\nif file_path is None or not os.path.exists(file_path):\r\n    result = \"Error: File not found.\"\r\nelse:\r\n    try:\r\n        bundle = joblib.load(file_path)\r\n        \r\n        if isinstance(bundle, dict):\r\n            loaded_model = bundle.get(\"model_object\")\r\n            loaded_scaler = bundle.get(\"scaler_object\")\r\n            loaded_encoder = bundle.get(\"encoder_object\")\r\n            result = \"Model Loaded successfully.\"\r\n        else:\r\n            loaded_model = bundle\r\n            result = \"Warning: Only Model loaded (No Scaler/Encoder found).\"\r\n\r\n    except Exception as e:\r\n        result = f\"Load Error: {str(e)}\"\r\n\r\n# OUTPUT\r\nOUT = [loaded_model, loaded_scaler, loaded_encoder, result]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "6753e9263138482abbd33d1be3cd1eb0",
      "NodeType": "PythonScriptNode",
      "Inputs": [
