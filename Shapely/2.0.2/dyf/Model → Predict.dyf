      ],
      "Replication": "Disabled",
      "Description": "Un paramètre de fonction, utiliser avec des noeuds personnalisés.\r\n\r\nVous pouvez spécifier le type et la valeur par défaut du paramètre. Par exemple,\r\n\r\nentrée: var[]..[]\r\nvaleur: bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n\r\nimport sys\r\nimport numpy as np\r\n\r\n# INPUT\r\ninput_object = IN[0]\r\nraw_data = IN[1]\r\n\r\npredictions = []\r\ndecoded_labels = []\r\nmsg = \"\"\r\n\r\nif input_object and raw_data:\r\n    try:\r\n        model = None\r\n        scaler = None\r\n        encoder = None\r\n\r\n        if isinstance(input_object, dict):\r\n            model = input_object.get(\"model_object\")\r\n            scaler = input_object.get(\"scaler_object\")\r\n            encoder = input_object.get(\"encoder_object\")\r\n        \r\n        else:\r\n            model = input_object\r\n            scaler = None\r\n            encoder = None\r\n\r\n        # ModelContainer\r\n        if hasattr(model, 'model'):\r\n            model = model.model\r\n\r\n        X = np.array(raw_data)\r\n        if X.ndim == 1:\r\n            X = X.reshape(1, -1)\r\n            \r\n        # Scaler\r\n        if scaler:\r\n            try:\r\n                X = scaler.transform(X)\r\n            except Exception as e:\r\n                msg += f\"Scaler Warning: {str(e)}. Using raw data. \"\r\n\r\n        # Predict\r\n        if hasattr(model, 'predict'):\r\n            predictions = model.predict(X).tolist()\r\n\r\n            # Decoding\r\n            decoded_labels = predictions\r\n            \r\n            if encoder:\r\n                try:\r\n                    if hasattr(encoder, 'inverse_transform'):\r\n                        decoded_labels = encoder.inverse_transform(predictions).tolist()\r\n                except:\r\n                    pass\r\n            \r\n            msg += \"Prediction Successful.\"\r\n        else:\r\n             msg = \"Error: Input is not a valid Scikit-learn model.\"\r\n        \r\n        # OUTPUT\r\n        OUT = [decoded_labels, msg]\r\n\r\n    except Exception as e:\r\n        OUT = [None, None, None, f\"Critical Error: {str(e)}\"]\r\nelse:\r\n    OUT = [None, None, None, \"Waiting for Input...\"]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "bcb48ab9141f438ab11e888c27bee3db",
      "NodeType": "PythonScriptNode",
      "Inputs": [
