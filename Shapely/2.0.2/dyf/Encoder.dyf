    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n# One-Hot & Label Encoder\r\n\r\nimport sys\r\nimport numpy as np\r\n\r\ntry:\r\n    from sklearn.preprocessing import OneHotEncoder, LabelEncoder\r\nexcept ImportError as e:\r\n    raise Exception(f\"Failed: {e}\")\r\n\r\ndef flatten_data_generator(input_data):\r\n    if isinstance(input_data, list):\r\n        for item in input_data:\r\n            yield from flatten_data_generator(item)\r\n    else:\r\n        yield input_data\r\n\r\ndef reconstruct_structure(original_structure, value_iterator):\r\n    if isinstance(original_structure, list):\r\n        return [reconstruct_structure(sub_item, value_iterator) for sub_item in original_structure]\r\n    else:\r\n        val = next(value_iterator)\r\n        if isinstance(val, (np.integer, np.int32, np.int64)):\r\n            return int(val)\r\n        elif isinstance(val, np.ndarray):\r\n            return val.tolist()\r\n        return val\r\n\r\ndef process_encoding(raw_data, use_label_mode=True):\r\n    flat_data_list = list(flatten_data_generator(raw_data))\r\n    \r\n    clean_data = [str(x) if x is not None else \"Unknown\" for x in flat_data_list]\r\n    \r\n    X = np.array(clean_data)\r\n    \r\n    encoded_values = []\r\n    classes_list = []\r\n    encoder_obj = None\r\n\r\n    if use_label_mode:\r\n        # LabelEncoder\r\n        encoder = LabelEncoder()\r\n        encoded_values = encoder.fit_transform(X)\r\n        classes_list = encoder.classes_.tolist()\r\n        encoder_obj = encoder\r\n    else:\r\n        # OheHotEncoder\r\n        X_reshaped = X.reshape(-1, 1)\r\n        encoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\r\n        encoded_matrix = encoder.fit_transform(X_reshaped)\r\n        \r\n        encoded_values = encoded_matrix\r\n        classes_list = encoder.get_feature_names_out(['Category']).tolist()\r\n        encoder_obj = encoder\r\n\r\n    data_iterator = iter(encoded_values)\r\n    \r\n    final_output = reconstruct_structure(raw_data, data_iterator)\r\n    \r\n    return final_output, encoder_obj, classes_list\r\n\r\n# Output\r\nif 'IN' in locals():\r\n    raw_data_input = IN[0]\r\n    use_label = IN[1] if len(IN) > 1 and isinstance(IN[1], bool) else False\r\n    result_data, encoder, categories = process_encoding(raw_data_input, use_label)\r\n    OUT = [result_data, encoder, categories]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "dc1066038b2a478faff2e94edc3dcd71",
      "NodeType": "PythonScriptNode",
