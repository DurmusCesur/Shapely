      "Replication": "Disabled",
      "Description": "Un paramètre de fonction, utiliser avec des noeuds personnalisés.\r\n\r\nVous pouvez spécifier le type et la valeur par défaut du paramètre. Par exemple,\r\n\r\nentrée: var[]..[]\r\nvaleur: bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n\r\nimport sys\r\nimport numpy as np\r\n\r\ntry:\r\n    from sklearn.metrics import silhouette_score\r\nexcept ImportError:\r\n    pass\r\n\r\ndef ensure_structure(data_matrix, label_list):\r\n    try:\r\n        X = np.array(data_matrix, dtype=np.float64)\r\n        if X.ndim == 1:\r\n            X = X.reshape(1, -1)\r\n            \r\n        y = np.array(label_list)\r\n        y = y.flatten() \r\n        \r\n        return X, y, None\r\n    except Exception as e:\r\n        return None, None, str(e)\r\n\r\n# INPUTS\r\ndata = IN[0]\r\nlabels = IN[1]\r\n\r\nresult = 0.0\r\nmsg = \"\"\r\n\r\nif data and labels:\r\n    X, y, error = ensure_structure(data, labels)\r\n    \r\n    if error:\r\n        msg = f\"Data Structure Error: {error}\"\r\n    else:\r\n        try:\r\n            unique_labels = np.unique(y)\r\n            \r\n            if len(unique_labels) < 2:\r\n                result = 0.0\r\n                msg = \"Score: 0.0 (Needs at least 2 clusters)\"\r\n            elif len(X) != len(y):\r\n                 msg = f\"Mismatch: Data has {len(X)} items, Labels has {len(y)} items.\"\r\n            else:\r\n                score = silhouette_score(X, y, metric='euclidean')\r\n                result = round(score, 4)\r\n                \r\n                if result > 0.7: msg = \"Excellent\"\r\n                elif result > 0.5: msg = \"Good\"\r\n                elif result > 0.25: msg = \"Weak (Overlapping).\"\r\n                else: msg = \"Bad clustering.\"\r\n                \r\n        except Exception as e:\r\n            msg = f\"Score Error: {str(e)}\"\r\nelse:\r\n    msg = \"No Input Data\"\r\n\r\n# OUTPUT\r\nOUT = [result, msg]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "ea0f1871885044c39d0383b2c633aab6",
      "NodeType": "PythonScriptNode",
