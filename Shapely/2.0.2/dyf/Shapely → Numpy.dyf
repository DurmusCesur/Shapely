      "Replication": "Disabled",
      "Description": "Sortie de fonction, utiliser avec les noeuds personnalisés"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1\r\n# Durmus Bayryam\r\nimport numpy as np\r\n\r\ntry:\r\n    from shapely.geometry import Point as ShpPoint\r\n    from shapely.geometry import LineString as ShpLineString\r\n    from shapely.geometry import Polygon as ShpPolygon\r\n    from shapely.geometry import LinearRing as ShpLinearRing\r\n    from shapely.geometry import MultiPoint as ShpMultiPoint\r\n    from shapely.geometry import MultiLineString as ShpMultiLineString\r\n    from shapely.geometry import MultiPolygon as ShpMultiPolygon\r\n    from shapely.geometry.base import BaseGeometry\r\nexcept ImportError:\r\n    print(\"\\n Please install Shapely and Numpy package!\")\r\n    pass\r\n\r\ndef ensure_3d_coords(coords_tuple):\r\n    if len(coords_tuple) == 2:\r\n        return [coords_tuple[0], coords_tuple[1], 0.0]\r\n    elif len(coords_tuple) >= 3:\r\n        return [coords_tuple[0], coords_tuple[1], coords_tuple[2]]\r\n    return [0.0, 0.0, 0.0] \r\n\r\n\r\ndef shapely_point_to_numpy(shp_point):\r\n    # ShpPoint -> np.array([x, y, z])\r\n    if not isinstance(shp_point, ShpPoint): return None\r\n    if shp_point.is_empty: return np.array([])\r\n    \r\n    return np.array(ensure_3d_coords(shp_point.coords[0]))\r\n\r\ndef shapely_linestring_to_numpy(shp_linestring):\r\n    if not isinstance(shp_linestring, ShpLineString): return None\r\n    if shp_linestring.is_empty: return np.array([])\r\n    \r\n    coords_3d = [ensure_3d_coords(c) for c in shp_linestring.coords]\r\n    return np.array(coords_3d)\r\n\r\ndef shapely_linearring_to_numpy(shp_ring):\r\n    if not isinstance(shp_ring, ShpLinearRing): return None\r\n    coords_3d = [ensure_3d_coords(c) for c in shp_ring.coords]\r\n    return np.array(coords_3d)\r\n\r\ndef shapely_multipoint_to_numpy(shp_multipoint):\r\n    # ShpMultiPoint -> np.array([[x1,y1,z1], ...])\r\n    if not isinstance(shp_multipoint, ShpMultiPoint): return None\r\n    if shp_multipoint.is_empty: return np.array([])\r\n\r\n    coords_list = []\r\n    for pt in shp_multipoint.geoms:\r\n        coords_list.append(ensure_3d_coords(pt.coords[0]))\r\n    \r\n    return np.array(coords_list)\r\n\r\ndef shapely_multilinestring_to_numpy(shp_multilinestring):\r\n    if not isinstance(shp_multilinestring, ShpMultiLineString): return None\r\n    return [shapely_linestring_to_numpy(ls) for ls in shp_multilinestring.geoms]\r\n\r\ndef shapely_polygon_to_numpy(shp_polygon, include_holes=True):\r\n    if not isinstance(shp_polygon, ShpPolygon): return None\r\n    \r\n    # Exterior\r\n    ext_list = [ensure_3d_coords(c) for c in shp_polygon.exterior.coords]\r\n    exterior_coords = np.array(ext_list)\r\n    \r\n    if not include_holes or len(shp_polygon.interiors) == 0:\r\n        return exterior_coords\r\n    \r\n    interior_arrays = []\r\n    for interior in shp_polygon.interiors:\r\n        int_list = [ensure_3d_coords(c) for c in interior.coords]\r\n        interior_arrays.append(np.array(int_list))\r\n    \r\n    return {\r\n        'exterior': exterior_coords,\r\n        'interiors': interior_arrays\r\n    }\r\n\r\ndef shapely_multipolygon_to_numpy(shp_multipolygon, include_holes=True):\r\n    if not isinstance(shp_multipolygon, ShpMultiPolygon): return None\r\n    return [shapely_polygon_to_numpy(poly, include_holes) for poly in shp_multipolygon.geoms]\r\n\r\ndef convert_shapely_to_numpy(shapely_geometry, include_holes=True):\r\n    if isinstance(shapely_geometry, list):\r\n        return [convert_shapely_to_numpy(item, include_holes) for item in shapely_geometry]\r\n    \r\n    if isinstance(shapely_geometry, ShpPoint):\r\n        return shapely_point_to_numpy(shapely_geometry)\r\n    elif isinstance(shapely_geometry, ShpLinearRing):\r\n        return shapely_linearring_to_numpy(shapely_geometry)\r\n    elif isinstance(shapely_geometry, ShpLineString):\r\n        return shapely_linestring_to_numpy(shapely_geometry)\r\n    elif isinstance(shapely_geometry, ShpPolygon):\r\n        return shapely_polygon_to_numpy(shapely_geometry, include_holes)\r\n    elif isinstance(shapely_geometry, ShpMultiPoint):\r\n        return shapely_multipoint_to_numpy(shapely_geometry)\r\n    elif isinstance(shapely_geometry, ShpMultiLineString):\r\n        return shapely_multilinestring_to_numpy(shapely_geometry)\r\n    elif isinstance(shapely_geometry, ShpMultiPolygon):\r\n        return shapely_multipolygon_to_numpy(shapely_geometry, include_holes)\r\n    else:\r\n        return None\r\n\r\nif 'IN' in locals():\r\n    dynamo_input = IN[0] \r\n    shapely_output = convert_shapely_to_numpy(dynamo_input)\r\n    OUT = shapely_output",
      "Engine": "CPython3",
      "VariableInputPorts": true,
