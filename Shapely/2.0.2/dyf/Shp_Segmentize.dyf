      "Replication": "Disabled",
      "Description": "Sortie de fonction, utiliser avec les noeuds personnalisés"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1\r\n# Durmus Bayram \r\n\r\nimport clr\r\n\r\ntry:\r\n    from shapely.geometry import Point as ShpPoint\r\n    from shapely.geometry import LineString as ShpLineString\r\n    from shapely.geometry import Polygon as ShpPolygon\r\n    from shapely.geometry import MultiPoint as ShpMultiPoint\r\n    from shapely.geometry import MultiLineString as ShpMultiLineString\r\n    from shapely.geometry import MultiPolygon as ShpMultiPolygon\r\n    from shapely.geometry import GeometryCollection as ShpGeometryCollection\r\n    from shapely.geometry.base import BaseGeometry\r\n    from shapely import segmentize\r\n    from shapely.geometry import LinearRing\r\nexcept ImportError:\r\n    print(\"\\n Please install Shapely package!\")\r\n\r\n\r\ndef segmentize_ring(ring_coords, max_dist):\r\n    if len(ring_coords) < 2:\r\n        return [ShpPoint(c) for c in ring_coords]\r\n\r\n    line = ShpLineString(ring_coords)\r\n\r\n    segmented_line = segmentize(line, max_segment_length=max_dist)\r\n\r\n    points = [ShpPoint(c) for c in segmented_line.coords[:-1]]\r\n\r\n    return points\r\n\r\n\r\ndef extract_all_points_fixed(geom, max_dist):\r\n    result = {\r\n        'exterior': [],\r\n        'interiors': [],\r\n        'all': []\r\n    }\r\n\r\n    if hasattr(geom, 'geoms'):\r\n        for g in geom.geoms:\r\n            sub_result = extract_all_points_fixed(g, max_dist)\r\n            result['exterior'].extend(sub_result['exterior'])\r\n            result['interiors'].extend(sub_result['interiors'])\r\n            result['all'].extend(sub_result['all'])\r\n\r\n    elif isinstance(geom, ShpPolygon):\r\n        exterior_points = segmentize_ring(list(geom.exterior.coords), max_dist)\r\n        result['exterior'] = exterior_points\r\n        result['all'].extend(exterior_points)\r\n\r\n        for hole in geom.interiors:\r\n            hole_points = segmentize_ring(list(hole.coords), max_dist)\r\n            result['interiors'].append(hole_points)\r\n            result['all'].extend(hole_points)\r\n\r\n    elif isinstance(geom, ShpLineString):\r\n        segmented = segmentize(geom, max_segment_length=max_dist)\r\n        points = [ShpPoint(c) for c in segmented.coords]\r\n        result['all'] = points\r\n\r\n    elif hasattr(geom, 'coords'):\r\n        points = [ShpPoint(c) for c in geom.coords]\r\n        result['all'] = points\r\n\r\n    return result\r\n\r\n\r\ndef get_shapely_segmentize_points_fixed(shp_input, max_dist, return_separate=True):\r\n    if isinstance(shp_input, list):\r\n        results = []\r\n        for item in shp_input:\r\n            results.append(\r\n                get_shapely_segmentize_points_fixed(item, max_dist, return_separate)\r\n            )\r\n        return results\r\n\r\n    if (\r\n        isinstance(shp_input, ShpPoint)\r\n        or not isinstance(shp_input, BaseGeometry)\r\n        or max_dist <= 0\r\n    ):\r\n        if return_separate:\r\n            return [\r\n                ShpMultiPoint([shp_input] if isinstance(shp_input, ShpPoint) else []),\r\n                []\r\n            ]\r\n        return ShpMultiPoint([shp_input] if isinstance(shp_input, ShpPoint) else [])\r\n\r\n    result = extract_all_points_fixed(shp_input, max_dist)\r\n\r\n    if return_separate:\r\n        exterior_mp = (\r\n            ShpMultiPoint(result['exterior'])\r\n            if result['exterior']\r\n            else ShpMultiPoint([])\r\n        )\r\n        interior_mps = [ShpMultiPoint(hole) for hole in result['interiors']]\r\n        return [exterior_mp, interior_mps]\r\n    else:\r\n        return ShpMultiPoint(result['all'])\r\n\r\n\r\nif 'IN' in locals():\r\n    shp_input = IN[0]\r\n    max_len = IN[1] if (IN[1] is not None and IN[1] > 0) else 1.0\r\n\r\n    return_separate = IN[2] if len(IN) > 2 and IN[2] is not None else False\r\n\r\n    result = get_shapely_segmentize_points_fixed(shp_input, max_len, return_separate)\r\n\r\n    OUT = result",
      "Engine": "CPython3",
      "VariableInputPorts": true,
