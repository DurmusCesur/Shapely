    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Output, DynamoCore",
      "ElementResolver": null,
      "Symbol": "_ShpPoint",
      "Id": "d71319123c944ac78278cc99b0ab9119",
      "NodeType": "OutputNode",
      "Inputs": [
        {
          "Id": "d679ba4d662c41cfa501c43d5902f986",
