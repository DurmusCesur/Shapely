    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026 \r\n# Durmus Bayryam\r\n# Spectral Clustering\r\n\r\nimport sys\r\nimport numpy as np\r\nimport math\r\n\r\ntry:\r\n    from sklearn.cluster import SpectralClustering\r\nexcept ImportError as e:\r\n    raise Exception(\"Scikit-learn not found.\")\r\n\r\n# INPUTS\r\ndata = IN[0]\r\nn_clusters = IN[1]\r\n\r\nlabels = []\r\nmodel_info = \"\"\r\n\r\nif data and len(data) > 0:\r\n    try:\r\n        X = np.array(data)\r\n        n_samples = len(X)\r\n        \r\n        # Magic\r\n        calculated_k = int(np.log(n_samples)) + 2 \r\n        \r\n        if n_samples < 2:\r\n            n_neighbors_dynamic = 1\r\n        else:\r\n            n_neighbors_dynamic = max(2, min(calculated_k, n_samples - 1))\r\n            \r\n        # Fit\r\n        model = SpectralClustering(\r\n            n_clusters=n_clusters, \r\n            affinity='nearest_neighbors',\r\n            n_neighbors=n_neighbors_dynamic, \r\n            random_state=42,\r\n            n_jobs=-1\r\n        )\r\n        \r\n        labels = model.fit_predict(X).tolist()\r\n        \r\n        OUT = [labels, model]\r\n        \r\n    except Exception as e:\r\n        OUT = f\"Spectral Error: {str(e)}\"\r\nelse:\r\n    OUT = \"No Data\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "72067ea6df6e48d3a943452bf94fa2a2",
      "NodeType": "PythonScriptNode",
      "Inputs": [
