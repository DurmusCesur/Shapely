      "Replication": "Disabled",
      "Description": "Un paramètre de fonction, utiliser avec des noeuds personnalisés.\r\n\r\nVous pouvez spécifier le type et la valeur par défaut du paramètre. Par exemple,\r\n\r\nentrée: var[]..[]\r\nvaleur: bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n\r\nimport sys\r\nimport numpy as np\r\nimport math\r\n\r\ntry:\r\n    from sklearn.preprocessing import StandardScaler\r\n    from shapely.geometry import Point, MultiPoint\r\n    from shapely.geometry import LineString, MultiLineString\r\n    from shapely.geometry import Polygon, MultiPolygon\r\n    from shapely.geometry import GeometryCollection\r\n    from shapely.geometry.base import BaseGeometry\r\nexcept ImportError as e:\r\n    raise Exception(f\"Failed: {e}\")\r\n\r\nclass MathUtils: \r\n    @staticmethod   \r\n    def calculate_compactness(area, perimeter):\r\n        # Polsby-Popper (4 * pi * Area) / Perimeter^2\r\n        if perimeter <= 0: return 0.0\r\n        val = (4 * np.pi * area) / (perimeter ** 2)\r\n        return min(max(val, 0.0), 1.0)\r\n\r\n    @staticmethod\r\n    def calculate_aspect_ratio(bounds):\r\n        minx, miny, maxx, maxy = bounds\r\n        width = maxx - minx\r\n        height = maxy - miny\r\n        if width <= 0.000001 or height <= 0.000001: return 0.0\r\n        return max(width, height) / min(width, height)\r\n\r\n    @staticmethod\r\n    def calculate_solidity(geom, area):\r\n        # Convex Hull\r\n        if area <= 0: return 0.0\r\n        convex_area = geom.convex_hull.area\r\n        if convex_area <= 0: return 0.0\r\n        return area / convex_area\r\n\r\n    @staticmethod\r\n    def calculate_rectangularity(area, bounds):\r\n        # Bounding Box\r\n        minx, miny, maxx, maxy = bounds\r\n        bbox_area = (maxx - minx) * (maxy - miny)\r\n        if bbox_area <= 0: return 0.0\r\n        return area / bbox_area\r\n\r\ndef flatten_data(input_data):\r\n    if isinstance(input_data, list):\r\n        for item in input_data:\r\n            yield from flatten_data(item)\r\n    else:\r\n        yield input_data\r\n\r\ndef extract_features(geom):\r\n    # [Area, Compactness, AspectRatio, Solidity, Rectangularity, CentroidX, CentroidY]\r\n    if geom is None or not isinstance(geom, BaseGeometry) or geom.is_empty:\r\n        return [0.0] * 7\r\n        \r\n    area = 0.0\r\n    perimeter = 0.0\r\n    aspect_ratio = 0.0\r\n    compactness = 0.0\r\n    solidity = 0.0\r\n    rectangularity = 0.0\r\n    c_x = 0.0\r\n    c_y = 0.0\r\n    \r\n    try:\r\n        bounds = geom.bounds\r\n        aspect_ratio = MathUtils.calculate_aspect_ratio(bounds)\r\n        \r\n        if geom.centroid:\r\n            c_x = geom.centroid.x\r\n            c_y = geom.centroid.y\r\n\r\n        if isinstance(geom, (Polygon, MultiPolygon)):\r\n            area = geom.area\r\n            perimeter = geom.length\r\n            compactness = MathUtils.calculate_compactness(area, perimeter)\r\n            solidity = MathUtils.calculate_solidity(geom, area)\r\n            rectangularity = MathUtils.calculate_rectangularity(area, bounds)\r\n            \r\n        elif isinstance(geom, (LineString, MultiLineString)):\r\n            perimeter = geom.length\r\n            \r\n        elif isinstance(geom, (Point, MultiPoint)):\r\n            compactness = 1.0 \r\n            aspect_ratio = 1.0\r\n            solidity = 1.0\r\n            rectangularity = 1.0\r\n            \r\n        elif isinstance(geom, GeometryCollection):\r\n            area = geom.area\r\n            perimeter = geom.length\r\n            compactness = MathUtils.calculate_compactness(area, perimeter)\r\n\r\n    except Exception:\r\n        return [0.0] * 7\r\n\r\n    return [area, compactness, aspect_ratio, solidity, rectangularity, c_x, c_y]\r\n\r\ndef process_pipeline(raw_input):\r\n    flat_geometry_list = list(flatten_data(raw_input))\r\n    \r\n    feature_matrix = []\r\n    for geom in flat_geometry_list:\r\n        features = extract_features(geom)\r\n        feature_matrix.append(features)\r\n    \r\n    if not feature_matrix:\r\n        return []\r\n\r\n    X = np.array(feature_matrix, dtype=np.float64)\r\n\r\n    return X \r\n\r\n# OUTPUT\r\nif 'IN' in locals():\r\n    shapely_input = IN[0]\r\n    result_matrix = process_pipeline(shapely_input)\r\n    OUT = result_matrix",
      "Engine": "CPython3",
