      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Output, DynamoCore",
      "ElementResolver": null,
      "Symbol": "_Ncluster",
      "Id": "f536a5a919e049b784f850c9eca0c39c",
      "NodeType": "OutputNode",
      "Inputs": [
        {
          "Id": "70503c4c07c44b0ea5e2acfbab7bd366",
          "Name": "",
          "Description": "Données de sortie",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
