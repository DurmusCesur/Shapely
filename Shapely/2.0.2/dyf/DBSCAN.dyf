      "Description": "Sortie de fonction, utiliser avec les noeuds personnalisés"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026 \r\n# Durmus Bayryam\r\n\r\nimport sys\r\nimport random\r\nimport numpy as np\r\n\r\ntry:\r\n    from sklearn.cluster import DBSCAN\r\n    from sklearn.neighbors import NearestNeighbors\r\nexcept ImportError:\r\n    raise Exception(\"Scikit-learn not found.\")\r\n\r\ndef find_optimal_eps(data, min_samples):\r\n    X = np.array(data)\r\n    nbrs = NearestNeighbors(n_neighbors=min_samples).fit(X)\r\n    distances, indices = nbrs.kneighbors(X)\r\n    k_dist = np.sort(distances[:, min_samples-1])\r\n    \r\n    y = k_dist\r\n    x = np.arange(len(y))\r\n    \r\n    x_norm = (x - x.min()) / (x.max() - x.min())\r\n    denom = (y.max() - y.min())\r\n    if denom == 0: return 0.5\r\n    y_norm = (y - y.min()) / denom\r\n    \r\n    p1 = np.array([x_norm[0], y_norm[0]])\r\n    p2 = np.array([x_norm[-1], y_norm[-1]])\r\n    \r\n    dist_list = []\r\n    for i in range(len(x_norm)):\r\n        p = np.array([x_norm[i], y_norm[i]])\r\n        d = np.abs(np.cross(p2 - p1, p1 - p)) / np.linalg.norm(p2 - p1)\r\n        dist_list.append(d)\r\n        \r\n    best_index = np.argmax(dist_list)\r\n    return max(k_dist[best_index], 0.1)\r\n\r\n\r\n# INPUTS\r\ndata = IN[0]\r\nuser_eps = IN[1]\r\nuser_min_samples = IN[2]\r\n\r\nX = np.array(data)\r\n\r\nif user_min_samples == \"Auto\" or user_min_samples is None:\r\n    n_features = X.shape[1]\r\n    min_samples = n_features + 1\r\nelse:\r\n    min_samples = int(user_min_samples)\r\n        \r\nfinal_eps = float(user_eps) if user_eps is not None else find_optimal_eps(X, min_samples)\r\n        \r\ntry:\r\n    model = DBSCAN(eps=final_eps, min_samples=min_samples)\r\n    labels = model.fit_predict(X)\r\n        \r\n    unique_labels = set(labels)\r\n    n_clusters = len(unique_labels)\r\n        \r\n        \r\n    OUT = [labels.tolist(), model, n_clusters]\r\n        \r\nexcept Exception as e:\r\n    OUT = f\"Error: {str(e)}\"",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "87272b06decb43a3b43e340432e3899d",
