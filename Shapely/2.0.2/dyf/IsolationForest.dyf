    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n# IsolationForest\r\n\r\nimport sys\r\nimport numpy as np\r\n\r\ntry:\r\n    from sklearn.ensemble import IsolationForest\r\nexcept ImportError:\r\n    pass\r\n\r\n# INPUTS\r\ndata = IN[0]\r\ncontamination = IN[1] if (len(IN) > 1 and IN[1] is not None) else 'auto'\r\n\r\nif data and len(data) > 0:\r\n    try:\r\n        X = np.array(data)\r\n        \r\n        clf = IsolationForest(contamination=contamination, random_state=42)\r\n        clf.fit(X)\r\n        \r\n        # -1: Anomaly\r\n        # 1: Normal\r\n        labels = clf.predict(X).tolist()\r\n        scores = clf.decision_function(X).tolist()\r\n        \r\n        OUT = labels\r\n        \r\n    except Exception as e:\r\n        OUT = f\"Error: {str(e)}\"\r\nelse:\r\n    OUT = \"No Data\"",
      "Engine": "CPython3",
