    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n\r\nimport sys\r\nimport numpy as np\r\n\r\ndef ensure_2d_array(data, name=\"Input\"):\r\n    try:\r\n        # Gelen veriyi dogrudan numpy float dizisine ceviriyoruz\r\n        arr = np.array(data, dtype=np.float64)\r\n        \r\n        # Eger tek boyutluysa (Orn: [3, 3, 3...] gibi etiket listesi)\r\n        if arr.ndim == 1:\r\n            # 1 Satir N Sutun DEGIL (1, -1)\r\n            # N Satir 1 Sutun yapmaliyiz (-1, 1) -> Butun sorun buradaydi!\r\n            arr = arr.reshape(-1, 1)\r\n            \r\n        return arr\r\n\r\n    except Exception as e:\r\n        return f\"Error in {name}: {str(e)}\"\r\n\r\n# INPUTS\r\nraw_a = IN[0] # Features\r\nraw_b = IN[1] # OneHot veya Label\r\n\r\n# PROCESS\r\nmat_a = ensure_2d_array(raw_a, \"Matrix A (Geometry)\")\r\nmat_b = ensure_2d_array(raw_b, \"Matrix B (OneHot)\")\r\n\r\nresult = []\r\n\r\n# Eger matris olustururken hata mesajina donustuyse (String ise)\r\nif isinstance(mat_a, str) or isinstance(mat_b, str):\r\n    OUT = [mat_a, mat_b]\r\nelse:\r\n    try:\r\n        rows_a = mat_a.shape[0]\r\n        rows_b = mat_b.shape[0]\r\n        \r\n        if rows_a != rows_b:\r\n            result = f\"Mismatch Error: Matrix A has {rows_a} rows, Matrix B has {rows_b} rows.\"\r\n        else:\r\n            # Matrisleri yan yana yapistir (axis=1)\r\n            joined_matrix = np.concatenate((mat_a, mat_b), axis=1)\r\n            \r\n            # Dynamo'nun rahat okumasi icin tekrar Python listesine cevir\r\n            result = joined_matrix\r\n            \r\n    except Exception as e:\r\n        result = f\"Join Error: {str(e)}\"\r\n\r\n# OUTPUT\r\nOUT = result",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "63ab71014d6b44ed9446d4f5055cd85a",
