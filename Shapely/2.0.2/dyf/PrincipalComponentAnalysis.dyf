        }
      ],
      "Outputs": [
        {
          "Id": "0f30a795f01643b6bdc99e0a6b88cb9a",
          "Name": "image",
          "Description": "Objet d'image obtenu à partir du fichier",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.IO.Image.ReadFromFile@var",
      "Replication": "Auto",
      "Description": "Charger le fichier en tant que bitmap.\n\nImage.ReadFromFile (file: var): var"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n# PCA Analysis\r\n\r\nimport sys\r\nimport numpy as np\r\nimport tempfile\r\nimport os\r\nimport clr\r\n\r\nclr.AddReference('System.Drawing')\r\nfrom System.Drawing import Bitmap, Graphics, Color, Pen, SolidBrush, Font, FontFamily, StringFormat, StringAlignment\r\nfrom System.Drawing.Imaging import ImageFormat\r\n\r\ntry:\r\n    from sklearn.decomposition import PCA\r\n    from sklearn.preprocessing import StandardScaler, MinMaxScaler\r\nexcept ImportError:\r\n    raise Exception(\"Sklearn libraries not found.\")\r\n\r\n# Plotter\r\nclass NativeDashboard:\r\n    def __init__(self, width=1200, height=600):\r\n        self.width = width\r\n        self.height = height\r\n        self.bmp = Bitmap(width, height)\r\n        self.g = Graphics.FromImage(self.bmp)\r\n        self.g.Clear(Color.White)\r\n        self.g.SmoothingMode = 2 \r\n        \r\n        self.font_title = Font(FontFamily.GenericSansSerif, 12, 1) \r\n        self.font_label = Font(FontFamily.GenericSansSerif, 9)\r\n        self.pen_axis = Pen(Color.Black, 2)\r\n        self.pen_grid = Pen(Color.LightGray, 1)\r\n        self.pen_grid.DashStyle = 2 # Dash Line\r\n        self.brush_text = SolidBrush(Color.Black)\r\n        \r\n        self.fmt_center = StringFormat()\r\n        self.fmt_center.Alignment = StringAlignment.Center\r\n        self.fmt_center.LineAlignment = StringAlignment.Center\r\n\r\n    def _map(self, val, src_min, src_max, dst_min, dst_max):\r\n        if src_max == src_min: return dst_min\r\n        return (val - src_min) * (dst_max - dst_min) / (src_max - src_min) + dst_min\r\n\r\n    def draw_scatter_panel(self, x_data, y_data, title, xlabel, ylabel, rect):\r\n        # Scatter Plot\r\n        rx, ry, rw, rh = rect\r\n        pad = 60\r\n        \r\n        # Cizim Alani\r\n        plot_x = rx + pad\r\n        plot_y = ry + pad\r\n        plot_w = rw - (2 * pad)\r\n        plot_h = rh - (2 * pad)\r\n        \r\n        # Data\r\n        x_min, x_max = min(x_data), max(x_data)\r\n        y_min, y_max = min(y_data), max(y_data)\r\n        \r\n        # Margin\r\n        x_span = x_max - x_min if x_max != x_min else 1.0\r\n        y_span = y_max - y_min if y_max != y_min else 1.0\r\n        x_min -= x_span * 0.1; x_max += x_span * 0.1\r\n        y_min -= y_span * 0.1; y_max += y_span * 0.1\r\n        \r\n        # Chart\r\n        self.g.DrawRectangle(self.pen_axis, plot_x, plot_y, plot_w, plot_h)\r\n\r\n        # Point\r\n        brush_pt = SolidBrush(Color.FromArgb(100, 0, 0, 255)) \r\n        pt_size = 10\r\n        \r\n        for x, y in zip(x_data, y_data):\r\n            px = self._map(x, x_min, x_max, plot_x, plot_x + plot_w)\r\n            py = self._map(y, y_min, y_max, plot_y + plot_h, plot_y)\r\n            self.g.FillEllipse(brush_pt, px - pt_size/2, py - pt_size/2, pt_size, pt_size)\r\n            self.g.DrawEllipse(Pen(Color.Black, 1), px - pt_size/2, py - pt_size/2, pt_size, pt_size)\r\n\r\n        # Legend\r\n        self.g.DrawString(title, self.font_title, self.brush_text, rx + rw/2, ry + 40, self.fmt_center)\r\n\r\n    def draw_bar_panel(self, values, title, xlabel, ylabel, rect):\r\n        # Bar Chart\r\n        rx, ry, rw, rh = rect\r\n        pad = 60\r\n        \r\n        plot_x = rx + pad \r\n        plot_y = ry + pad\r\n        plot_w = rw - (1.2 * pad)\r\n        plot_h = rh - (2 * pad)\r\n        \r\n        count = len(values)\r\n        max_val = max(values) * 1.1\r\n        \r\n        # Chart\r\n        bar_width = (plot_w / count) * 0.5\r\n        gap = (plot_w / count) * 1\r\n        \r\n        brush_bar = SolidBrush(Color.FromArgb(150, 0, 0, 255))\r\n        \r\n        for i, val in enumerate(values):\r\n            # X\r\n            px = plot_x + (i * (plot_w / count)) + (gap / 2)\r\n            \r\n            # Y\r\n            bar_h = self._map(val, 0, max_val, 0, plot_h)\r\n            py = (plot_y + plot_h) - bar_h\r\n            \r\n            # Bar\r\n            self.g.FillRectangle(brush_bar, px, py, bar_width, bar_h)\r\n            self.g.DrawRectangle(Pen(Color.Black, 2), px, py, bar_width, bar_h)\r\n            \r\n            # %label\r\n            txt = f\"{val:.1f}%\"\r\n            self.g.DrawString(txt, self.font_label, self.brush_text, px + bar_width/2, py - 20, self.fmt_center)\r\n            \r\n            # (PC1, PC2...)\r\n            self.g.DrawString(str(i+1), self.font_label, self.brush_text, px + bar_width/2, plot_y + plot_h + 20, self.fmt_center)\r\n\r\n        # Legend\r\n        self.g.DrawString(title, self.font_title, self.brush_text, rx + rw/1.5, ry + 40, self.fmt_center)\r\n\r\n\r\n    def save(self, path):\r\n        self.bmp.Save(path, ImageFormat.Png)\r\n        self.g.Dispose()\r\n        self.bmp.Dispose()\r\n        return path\r\n\r\n# Base\r\ndef visualize_pca_dashboard(data, n_components=2, use_minmax=True):\r\n    X = np.array(data)\r\n    \r\n    # 1. Scaler\r\n    if use_minmax:\r\n        scaler = MinMaxScaler()\r\n    else:\r\n        scaler = StandardScaler()\r\n        \r\n    X_scaled = scaler.fit_transform(X)\r\n    \r\n    # 2. PCA\r\n    pca = PCA(n_components=n_components)\r\n    principal_components = pca.fit_transform(X_scaled)\r\n    \r\n    explained_variance_ratio = pca.explained_variance_ratio_\r\n    total_variance = np.sum(explained_variance_ratio) * 100\r\n    \r\n    # Visualization\r\n    dash = NativeDashboard(1200, 600)\r\n    \r\n    # Panel\r\n    dash.draw_scatter_panel(\r\n        x_data=principal_components[:, 0],\r\n        y_data=principal_components[:, 1],\r\n        title=f\"PCA Projection (Total: {total_variance:.1f}%)\",\r\n        xlabel=f\"PC 1 ({explained_variance_ratio[0]*100:.1f}%)\",\r\n        ylabel=f\"PC 2 ({explained_variance_ratio[1]*100:.1f}%)\",\r\n        rect=(0, 0, 950, 600)\r\n    )\r\n    \r\n    # Bar\r\n    dash.draw_bar_panel(\r\n        values=explained_variance_ratio * 100,\r\n        title=\"Explained Variance\",\r\n        xlabel=\"Principal Components\",\r\n        ylabel=\"Variance (%)\",\r\n        rect=(800, 0, 400, 600)\r\n    )\r\n    \r\n    # 4. Save\r\n    temp_dir = tempfile.gettempdir()\r\n    file_name = \"PCA_Analysis.png\"\r\n    path_out = os.path.join(temp_dir, file_name)\r\n    \r\n    if os.path.exists(path_out):\r\n        try: os.remove(path_out)\r\n        except: pass\r\n            \r\n    dash.save(path_out)\r\n    \r\n    return path_out, total_variance, principal_components\r\n\r\n# OUTPUT\r\nif 'IN' in locals():\r\n    raw_data = IN[0]\r\n    valiable_scaler = IN[1]\r\n    \r\n    if raw_data:\r\n        try:\r\n            image_path, variance_score, pca_data = visualize_pca_dashboard(raw_data, n_components=3, use_minmax=valiable_scaler)\r\n            OUT = [image_path, pca_data, variance_score]\r\n        except Exception as e:\r\n            OUT = [f\"Error: {str(e)}\", None, None]\r\n    else:\r\n        OUT = [\"No Data\", None, None]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "444eb08de6924d8bbfad0c63d9d6ab3f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
