    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Copyright(c) 2026\r\n# Durmus Bayryam\r\n# Mean Absolute Error\r\n\r\nimport sys\r\nimport numpy as np\r\n\r\ntry:\r\n    from sklearn.metrics import mean_absolute_error\r\nexcept ImportError:\r\n    pass\r\n\r\n# INPUTS\r\ny_true = IN[0]\r\ny_pred = IN[1]\r\n\r\nif y_true and y_pred:\r\n    try:\r\n        true_arr = np.array(y_true).flatten()\r\n        pred_arr = np.array(y_pred).flatten()\r\n                \r\n        mae = round(mean_absolute_error(true_arr, pred_arr), 2)\r\n        \r\n        OUT = mae\r\n        \r\n    except Exception as e:\r\n        OUT = [0, 0, 0, f\"Error: {str(e)}\"]\r\nelse:\r\n    OUT = [0, 0, 0, \"No Data\"]",
      "Engine": "CPython3",
