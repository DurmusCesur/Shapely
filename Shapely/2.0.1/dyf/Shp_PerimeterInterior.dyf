    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1\r\n# Durmus Bayram\r\nimport clr\r\n\r\ntry:\r\n    from shapely.geometry import Point as ShpPoint\r\n    from shapely.geometry import LineString as ShpLineString\r\n    from shapely.geometry import Polygon as ShpPolygon\r\n    from shapely.geometry import MultiPoint as ShpMultiPoint\r\n    from shapely.geometry import MultiLineString as ShpMultiLineString\r\n    from shapely.geometry import MultiPolygon as ShpMultiPolygon\r\n    from shapely.geometry import GeometryCollection as ShpGeometryCollection\r\n    from shapely.geometry import LinearRing\r\n    from shapely.geometry.base import BaseGeometry\r\n    from shapely import get_interior_ring, get_num_interior_rings\r\n    \r\nexcept ImportError:\r\n    print(\"\\n Please install Shapely package!\")\r\n\r\ndef get_all_interiors(geom):\r\n    holes = []\r\n    \r\n    if isinstance(geom, ShpPolygon):\r\n        holes.extend(list(geom.interiors))\r\n        \r\n    elif isinstance(geom, ShpMultiPolygon):\r\n        for poly in geom.geoms:\r\n            holes.extend(list(poly.interiors))\r\n            \r\n    elif hasattr(geom, 'geoms'):\r\n        for g in geom.geoms:\r\n            holes.extend(get_all_interiors(g))\r\n            \r\n    return holes\r\n\r\ndef process_geometry_list(input_data):\r\n    if isinstance(input_data, list):\r\n        return [process_geometry_list(item) for item in input_data]\r\n    \r\n    elif isinstance(input_data, BaseGeometry):\r\n        return get_all_interiors(input_data)\r\n    \r\n    return None\r\n\r\nif 'IN' in locals():\r\n    shp_input = IN[0]\r\n    \r\n    OUT = process_geometry_list(shp_input)",
      "Engine": "CPython3",
