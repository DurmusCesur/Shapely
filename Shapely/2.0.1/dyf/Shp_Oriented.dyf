      "Replication": "Disabled",
      "Description": "Sortie de fonction, utiliser avec les noeuds personnalisés"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1\r\n# Durmus Bayram\r\nimport clr\r\n\r\ntry:\r\n    from shapely.geometry import Polygon as ShpPolygon\r\n    from shapely.geometry import MultiPolygon as ShpMultiPolygon\r\n    from shapely.geometry import GeometryCollection as ShpGeometryCollection \r\n    from shapely.ops import orient\r\nexcept ImportError:\r\n    print(\"\\n Please install Shapely package!\")\r\n    pass\r\n\r\ndef safe_orient(geom, sign):\r\n    # Polygon\r\n    if isinstance(geom, ShpPolygon):\r\n        return orient(geom, sign=sign)\r\n        \r\n    # MultiPolygon\r\n    elif isinstance(geom, ShpMultiPolygon):\r\n        return ShpMultiPolygon([orient(p, sign=sign) for p in geom.geoms])\r\n\r\n    # GeometryCollection\r\n    elif isinstance(geom, ShpGeometryCollection):\r\n        return ShpGeometryCollection([safe_orient(g, sign) for g in geom.geoms])\r\n        \r\n    return geom\r\n\r\ndef get_shapely_orient(input_data, sign=1.0):\r\n    if isinstance(input_data, list):\r\n        return [get_shapely_orient(item, sign) for item in input_data]\r\n    \r\n    return safe_orient(input_data, sign)\r\n\r\nif 'IN' in locals():\r\n    shp_input = IN[0]\r\n    sign_val = IN[1] if len(IN) > 1 and IN[1] is not None else 1.0\r\n    \r\n    output = get_shapely_orient(shp_input, sign_val)\r\n    \r\n    OUT = output",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "f02cab2b157e47c1ab1bd69f789ac937",
      "NodeType": "PythonScriptNode",
