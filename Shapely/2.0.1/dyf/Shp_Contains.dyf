      ],
      "Replication": "Disabled",
      "Description": "Un paramètre de fonction, utiliser avec des noeuds personnalisés.\r\n\r\nVous pouvez spécifier le type et la valeur par défaut du paramètre. Par exemple,\r\n\r\nentrée: var[]..[]\r\nvaleur: bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1 \r\n# Durmus Bayram \r\nimport clr\r\n\r\ntry:\r\n    from shapely.geometry import Point as ShpPoint\r\n    from shapely.geometry import MultiPoint as ShpMultiPoint\r\n    from shapely.geometry import MultiLineString as ShpMultiLineString\r\n    from shapely.geometry import MultiPolygon as ShpMultiPolygon\r\n    from shapely.geometry.base import BaseGeometry\r\n    from shapely.prepared import prep \r\nexcept ImportError:\r\n    pass\r\n\r\ndef prepare_geometry(geometry):\r\n    if isinstance(geometry, BaseGeometry):\r\n        return prep(geometry)\r\n    return geometry \r\n\r\ndef check_contains_prepared(prepared_container, other_geometry):\r\n    if hasattr(other_geometry, 'geoms'):\r\n        return [prepared_container.contains(sub_geom) for sub_geom in other_geometry.geoms]\r\n    \r\n    if not hasattr(prepared_container, 'contains'):\r\n        return False\r\n    if not isinstance(other_geometry, BaseGeometry):\r\n        return False\r\n        \r\n    return prepared_container.contains(other_geometry)\r\n\r\ndef get_shapely_contains_performance(container_input, other_input):\r\n    if isinstance(container_input, BaseGeometry):\r\n        prepared_container = prepare_geometry(container_input)\r\n        \r\n        if isinstance(other_input, list):\r\n            return [check_contains_prepared(prepared_container, other) for other in other_input]\r\n        else:\r\n            return check_contains_prepared(prepared_container, other_input)\r\n            \r\n    elif isinstance(container_input, list):\r\n        prepared_containers = [prepare_geometry(item) for item in container_input if isinstance(item, BaseGeometry)]\r\n        \r\n        if not isinstance(other_input, list):\r\n            return [check_contains_prepared(prep_c, other_input) for prep_c in prepared_containers]\r\n        \r\n        elif isinstance(other_input, list):\r\n            max_len = max(len(prepared_containers), len(other_input))\r\n            results = []\r\n            for i in range(max_len):\r\n                prep_c = prepared_containers[i] if i < len(prepared_containers) else prepared_containers[-1]\r\n                other = other_input[i] if i < len(other_input) else other_input[-1]\r\n                results.append(check_contains_prepared(prep_c, other))\r\n            return results\r\n            \r\n    return None\r\n\r\nif 'IN' in locals():\r\n    container_input = IN[0]\r\n    other_input = IN[1] if len(IN) > 1 else None\r\n    \r\n    if container_input is not None and other_input is not None:\r\n        OUT = get_shapely_contains_performance(container_input, other_input)\r\n    else:\r\n        OUT = False",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "70fed2d622f94085bf301caeb171fb74",
