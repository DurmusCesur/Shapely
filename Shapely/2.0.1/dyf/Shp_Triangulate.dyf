      "Replication": "Disabled",
      "Description": "Un paramètre de fonction, utiliser avec des noeuds personnalisés.\r\n\r\nVous pouvez spécifier le type et la valeur par défaut du paramètre. Par exemple,\r\n\r\nentrée: var[]..[]\r\nvaleur: bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1\r\n# Durmus Bayram \r\nimport clr\r\n\r\ntry:\r\n    from shapely.geometry import Point as ShpPoint\r\n    from shapely.geometry import LineString as ShpLineString\r\n    from shapely.geometry import Polygon as ShpPolygon\r\n    from shapely.geometry import MultiPoint as ShpMultiPoint\r\n    from shapely.geometry import MultiLineString as ShpMultiLineString\r\n    from shapely.geometry import MultiPolygon as ShpMultiPolygon\r\n    from shapely.geometry.base import BaseGeometry\r\n    from shapely.ops import triangulate\r\n    from shapely import prepare\r\nexcept ImportError:\r\n    pass\r\n\r\ndef shapely_triangulate_with_intersection(geom, clip_geometry=None):\r\n    if not isinstance(geom, BaseGeometry):\r\n        return None\r\n    \r\n    triangles = triangulate(geom)\r\n    \r\n    if clip_geometry is None:\r\n        return triangles\r\n    \r\n    if not isinstance(clip_geometry, (ShpPolygon, ShpMultiPolygon)):\r\n        return triangles\r\n    \r\n    if clip_geometry.is_empty or clip_geometry.area < 1e-10:\r\n        return triangles\r\n    \r\n    prepare(clip_geometry)\r\n    clipped_triangles = []\r\n    \r\n    for triangle in triangles:\r\n        if clip_geometry.contains(triangle):\r\n            clipped_triangles.append(triangle)\r\n        elif clip_geometry.intersects(triangle):\r\n            intersection_result = clip_geometry.intersection(triangle)\r\n            \r\n            if not intersection_result.is_empty:\r\n                if isinstance(intersection_result, ShpPolygon) and intersection_result.area > 1e-10:\r\n                    clipped_triangles.append(intersection_result)\r\n                elif isinstance(intersection_result, ShpMultiPolygon):\r\n                    for poly in intersection_result.geoms:\r\n                        if poly.area > 1e-10:\r\n                            clipped_triangles.append(poly)\r\n                elif hasattr(intersection_result, \"geoms\"):\r\n                     for geom in intersection_result.geoms:\r\n                         if isinstance(geom, ShpPolygon) and geom.area > 1e-10:\r\n                             clipped_triangles.append(geom)\r\n\r\n    return clipped_triangles\r\n\r\ndef handle_single_geometry(geom, clip, indiv_mode):\r\n    if isinstance(geom, (ShpMultiPoint, ShpMultiLineString, ShpMultiPolygon)):\r\n        if indiv_mode:\r\n            results = []\r\n            for sub_g in geom.geoms:\r\n                actual_clip = sub_g if clip is None and isinstance(sub_g, ShpPolygon) else clip\r\n                results.append(shapely_triangulate_with_intersection(sub_g, actual_clip))\r\n            return results\r\n        else:\r\n            actual_clip = geom if clip is None and isinstance(geom, ShpMultiPolygon) else clip\r\n            return shapely_triangulate_with_intersection(geom, actual_clip)\r\n\r\n    elif isinstance(geom, ShpPolygon):\r\n        actual_clip = geom if clip is None else clip\r\n        return shapely_triangulate_with_intersection(geom, actual_clip)\r\n    \r\n    else:\r\n        return shapely_triangulate_with_intersection(geom, clip)\r\n\r\ndef process_lacing(geom_input, clip_input, indiv_mode):\r\n    current_geom = geom_input\r\n    if isinstance(geom_input, list) and len(geom_input) > 0 and all(isinstance(x, ShpPoint) for x in geom_input):\r\n        current_geom = ShpMultiPoint(geom_input)\r\n\r\n    if isinstance(current_geom, list) or isinstance(clip_input, list):\r\n        \r\n        list_g = current_geom if isinstance(current_geom, list) else [current_geom]\r\n        list_c = clip_input if isinstance(clip_input, list) else [clip_input]\r\n        \r\n        max_len = max(len(list_g), len(list_c))\r\n        results = []\r\n        \r\n        for i in range(max_len):\r\n            item_g = list_g[i] if i < len(list_g) else list_g[-1]\r\n            \r\n            if clip_input is None:\r\n                item_c = None\r\n            else:\r\n                item_c = list_c[i] if i < len(list_c) else list_c[-1]\r\n            \r\n            results.append(process_lacing(item_g, item_c, indiv_mode))\r\n            \r\n        return results\r\n\r\n    else:\r\n        return handle_single_geometry(current_geom, clip_input, indiv_mode)\r\n\r\nif 'IN' in locals():\r\n    shp_input = IN[0]\r\n    clip_geom = IN[1] if len(IN) > 1 else None\r\n    indiv_mode = IN[2] if len(IN) > 2 else False\r\n\r\n    OUT = process_lacing(shp_input, clip_geom, indiv_mode)",
      "Engine": "CPython3",
