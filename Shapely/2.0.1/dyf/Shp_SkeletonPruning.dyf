      "Replication": "Disabled",
      "Description": "Un paramètre de fonction, utiliser avec des noeuds personnalisés.\r\n\r\nVous pouvez spécifier le type et la valeur par défaut du paramètre. Par exemple,\r\n\r\nentrée: var[]..[]\r\nvaleur: bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1\r\n# Durmus Bayram\r\nimport clr\r\n\r\ntry:\r\n    from shapely.geometry import Point as ShpPoint\r\n    from shapely.geometry import LineString as ShpLineString\r\n    from shapely.geometry import MultiLineString as ShpMultiLineString\r\n    from shapely.geometry.base import BaseGeometry\r\n    from shapely.ops import linemerge, unary_union\r\nexcept ImportError:\r\n    print(\"\\n Please install Shapely package!\")\r\n\r\ndef extract_lines(geom):\r\n    lines = []\r\n    if isinstance(geom, ShpLineString):\r\n        lines.append(geom)\r\n    elif hasattr(geom, 'geoms'): \r\n        for g in geom.geoms:\r\n            lines.extend(extract_lines(g))\r\n    return lines\r\n\r\ndef prune_skeleton(geometry, min_length=1.0, max_iterations=5):\r\n\r\n    if not isinstance(geometry, BaseGeometry) or geometry.is_empty:\r\n        return geometry\r\n\r\n    current_geom = geometry\r\n    iter_limit = int(max_iterations) \r\n\r\n    for i in range(iter_limit):\r\n        \r\n        input_lines = extract_lines(current_geom)\r\n        \r\n        if not input_lines:\r\n            break\r\n            \r\n        if len(input_lines) > 1:\r\n            try:\r\n                merged = linemerge(input_lines)\r\n            except ValueError:\r\n                merged = unary_union(input_lines)\r\n        else:\r\n            merged = input_lines[0]\r\n\r\n        lines_to_process = extract_lines(merged)\r\n        \r\n        node_counts = {}\r\n        for line in lines_to_process:\r\n            if not hasattr(line, 'coords') or len(line.coords) < 2: continue\r\n            \r\n            for pt in [line.coords[0], line.coords[-1]]:\r\n                node_counts[pt] = node_counts.get(pt, 0) + 1\r\n        \r\n        cleaned_lines = []\r\n        any_removed = False\r\n        \r\n        for line in lines_to_process:\r\n            if not hasattr(line, 'coords'): continue\r\n            \r\n            start_pt = line.coords[0]\r\n            end_pt = line.coords[-1]\r\n            \r\n            is_dead_end = (node_counts.get(start_pt, 0) == 1 or \r\n                           node_counts.get(end_pt, 0) == 1)\r\n            \r\n            if is_dead_end and line.length < min_length:\r\n                any_removed = True\r\n                continue \r\n            else:\r\n                cleaned_lines.append(line)\r\n        \r\n        current_geom = unary_union(cleaned_lines)\r\n        \r\n        if not any_removed:\r\n            break\r\n            \r\n    return current_geom\r\n\r\ndef get_skeleton_purge(input_data, min_length, max_iterations):\r\n    if isinstance(input_data, list):\r\n        return [get_skeleton_purge(item, min_length, max_iterations) for item in input_data]\r\n    \r\n    elif isinstance(input_data, BaseGeometry):\r\n        return prune_skeleton(input_data, min_length, max_iterations)\r\n        \r\n    return None\r\n\r\nif 'IN' in locals():\r\n    centerline_input = IN[0] \r\n    \r\n    threshold = IN[1] if (len(IN) > 1 and IN[1] is not None) else 1.0 \r\n    max_iter = IN[2] if (len(IN) > 2 and IN[2] is not None) else 10 \r\n    \r\n    OUT = get_skeleton_purge(centerline_input, threshold, max_iter)",
      "Engine": "CPython3",
