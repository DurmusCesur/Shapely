    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1\r\n# Durmus Bayryam\r\nimport sys\r\nimport os\r\n\r\n# PIP Instal Offlıne #\r\ndef load_embedded_packages():\r\n    package_name = \"Shapely\"\r\n    appdata = os.getenv(\"APPDATA\")\r\n    dynamo_root = os.path.join(appdata, \"Dynamo\", \"Dynamo Revit\")\r\n\r\n    if not os.path.exists(dynamo_root):\r\n        return False\r\n\r\n    found_lib_path = None\r\n    for version_dir in os.listdir(dynamo_root):\r\n        bin_path = os.path.join(\r\n            dynamo_root,\r\n            version_dir,\r\n            \"packages\",\r\n            package_name,\r\n            \"bin\"\r\n        )\r\n\r\n        shapely_path = os.path.join(bin_path, \"shapely_lib\")\r\n        numpy_path = os.path.join(bin_path, \"numpy_lib\")\r\n        geojson_path = os.path.join(bin_path, \"geojson_lib\")\r\n\r\n        if all(os.path.exists(p) for p in [shapely_path, numpy_path, geojson_path]):\r\n            found_lib_path = bin_path\r\n\r\n            for p in [numpy_path, shapely_path, geojson_path]:\r\n                if p not in sys.path:\r\n                    sys.path.insert(0, p)\r\n\r\n            # DLL \r\n            dll_path = os.path.join(shapely_path, \"shapely.libs\")\r\n            if os.path.exists(dll_path):\r\n                try:\r\n                    os.add_dll_directory(dll_path)\r\n                except AttributeError:\r\n                    pass\r\n                    \r\n            return True\r\n    return False\r\n\r\n\r\nis_loaded = load_embedded_packages()\r\n\r\n### -- -- -- -- -- - -- - -- - -- - - -- - - -- - - -- - - -##\r\n\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\ntry:\r\n    import shapely\r\n    from shapely.geometry import Point as ShpPoint\r\n    from shapely.geometry import LineString as ShpLineString\r\n    from shapely.geometry import Polygon as ShpPolygon , LinearRing\r\nexcept ImportError:\r\n    \r\n    print(\"\\n Please install Shapely package!\")\r\n    pass\r\n\r\ndef dynamo_point_to_shapely(dynamo_point):\r\n    \r\n    if isinstance(dynamo_point, Point):\r\n        return ShpPoint(dynamo_point.X, dynamo_point.Y, dynamo_point.Z)\r\n    return None\r\n\r\ndef dynamo_polygon_to_shapely(dynamo_polygon):\r\n    \r\n    if not isinstance(dynamo_polygon, Polygon):\r\n        return None\r\n    pts = dynamo_polygon.Points\r\n    if not pts or len(pts) < 3:\r\n        return None\r\n    coords = [(p.X, p.Y, p.Z) for p in pts]\r\n    if coords[0] != coords[-1]:\r\n        coords.append(coords[0])\r\n    return ShpPolygon(coords)\r\n\r\ndef dynamo_curve_to_shapely(dynamo_curve):\r\n    \r\n    if isinstance(dynamo_curve, Line):\r\n        start = dynamo_curve.StartPoint\r\n        end = dynamo_curve.EndPoint\r\n        coords = [(start.X, start.Y, start.Z), (end.X, end.Y, end.Z)]\r\n        \r\n        return ShpLineString(coords)\r\n        \r\n    elif isinstance(dynamo_curve, Arc):\r\n        \r\n        num_segments = 1000 \r\n        points = []\r\n        for i in range(num_segments + 1):\r\n            param = float(i) / num_segments\r\n            pt = dynamo_curve.PointAtParameter(param)\r\n            points.append((pt.X, pt.Y, pt.Z))\r\n        return ShpLineString(points)\r\n    return None\r\n\r\ndef dynamo_surface_to_shapely_with_holes(dynamo_surface):\r\n    if not isinstance(dynamo_surface, Surface):\r\n        return None\r\n    \r\n    all_loops_coords = []\r\n    \r\n    try:\r\n        perimeter_curves = dynamo_surface.PerimeterCurves()\r\n        \r\n        if not perimeter_curves:\r\n            return None\r\n\r\n        TOLERANCE = 1e-5\r\n        \r\n        def p2t(point):\r\n            return (point.X, point.Y, point.Z)\r\n            \r\n        def are_points_close(p1, p2):\r\n            dist_sq = (p1.X - p2.X)**2 + (p1.Y - p2.Y)**2 + (p1.Z - p2.Z)**2\r\n            return dist_sq < TOLERANCE**2\r\n\r\n        remaining_curves = list(perimeter_curves)\r\n        loops = []\r\n        current_loop = []\r\n        \r\n        while remaining_curves:\r\n            if not current_loop:\r\n                current_loop.append(remaining_curves.pop(0))\r\n            else:\r\n                last_curve = current_loop[-1]\r\n                expected_start = last_curve.EndPoint\r\n                \r\n                found_next = False\r\n                for i, curve in enumerate(remaining_curves):\r\n                    if are_points_close(curve.StartPoint, expected_start):\r\n                        current_loop.append(remaining_curves.pop(i))\r\n                        found_next = True\r\n                        break\r\n                \r\n                if not found_next:\r\n                    loops.append(current_loop)\r\n                    current_loop = []\r\n        \r\n        if current_loop:\r\n            loops.append(current_loop)\r\n            \r\n        for loop_curves in loops:\r\n            coords = []\r\n            for curve in loop_curves:\r\n                coords.append(p2t(curve.StartPoint))\r\n            \r\n            last_end = loop_curves[-1].EndPoint\r\n            first_start = loop_curves[0].StartPoint\r\n            \r\n            if not are_points_close(last_end, first_start):\r\n                 coords.append(p2t(last_end))\r\n            \r\n            if coords and coords[0] != coords[-1]:\r\n                 coords.append(coords[0])\r\n\r\n            all_loops_coords.append(coords)\r\n            \r\n    except Exception as e:\r\n        # print(f\"Hata: {e}\")\r\n        return None\r\n\r\n    if not all_loops_coords:\r\n        return None\r\n    \r\n    candidate_polygons = []\r\n    for coords in all_loops_coords:\r\n        if len(coords) >= 4: #3\r\n             try:\r\n                 poly = ShpPolygon(coords)\r\n                 if not poly.is_valid:\r\n                     poly = poly.buffer(0) \r\n                 candidate_polygons.append(poly)\r\n             except:\r\n                 pass\r\n    \r\n    if not candidate_polygons:\r\n        return None\r\n        \r\n    candidate_polygons.sort(key=lambda p: p.area, reverse=True)\r\n    \r\n    outer_poly = candidate_polygons[0]\r\n    inner_polys = candidate_polygons[1:]\r\n    \r\n    outer_coords = list(outer_poly.exterior.coords)\r\n    \r\n    inner_rings_coords = [list(p.exterior.coords) for p in inner_polys]\r\n    \r\n    try:\r\n        if inner_rings_coords:\r\n            return ShpPolygon(outer_coords, inner_rings_coords)\r\n        else:\r\n            return ShpPolygon(outer_coords)\r\n    except Exception as e:\r\n        return None\r\n\r\n\r\ndef dynamo_polycurve_to_shapely(dynamo_polycurve):\r\n    \r\n    if not isinstance(dynamo_polycurve, PolyCurve):\r\n        return None\r\n    \r\n    try:\r\n        curves = dynamo_polycurve.Curves()\r\n    except:\r\n        try:\r\n            curves = dynamo_polycurve.Curves\r\n        except:\r\n            return None\r\n    \r\n    if not curves:\r\n        return None\r\n    \r\n    coords = []\r\n    \r\n    for curve in curves:\r\n        try:\r\n            sp = curve.StartPoint\r\n            coords.append((sp.X, sp.Y, sp.Z))\r\n        except:\r\n            continue\r\n    \r\n    if curves:\r\n        try:\r\n            ep = curves[-1].EndPoint\r\n            coords.append((ep.X, ep.Y, ep.Z))\r\n        except:\r\n            pass\r\n    \r\n    if len(coords) < 2:\r\n        return None\r\n    \r\n    return ShpLineString(coords)\r\n\r\ndef convert_dynamo_to_shapely(dynamo_geometry):\r\n    \r\n    if isinstance(dynamo_geometry, list):\r\n        return [convert_dynamo_to_shapely(item) for item in dynamo_geometry]\r\n\r\n    if isinstance(dynamo_geometry, Point):\r\n        return dynamo_point_to_shapely(dynamo_geometry)\r\n\r\n    elif isinstance(dynamo_geometry, Surface):\r\n        return dynamo_surface_to_shapely_with_holes(dynamo_geometry)\r\n\r\n    elif isinstance(dynamo_geometry, Polygon):\r\n        return dynamo_polygon_to_shapely(dynamo_geometry)\r\n\r\n    elif isinstance(dynamo_geometry, PolyCurve):\r\n        return dynamo_polycurve_to_shapely(dynamo_geometry)\r\n\r\n    elif isinstance(dynamo_geometry, Line):\r\n        return dynamo_curve_to_shapely(dynamo_geometry)\r\n\r\n    else:\r\n        return None \r\n\r\nif 'IN' in locals():\r\n    dynamo_input = IN[0] \r\n\r\n    shapely_output = convert_dynamo_to_shapely(dynamo_input)\r\n\r\n    OUT = shapely_output",
      "Engine": "CPython3",
