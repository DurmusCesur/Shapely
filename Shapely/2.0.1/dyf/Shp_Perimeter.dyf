    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1\r\n# Durmus Bayram\r\nimport clr\r\n\r\ntry:\r\n    from shapely.geometry import Polygon as ShpPolygon\r\n    from shapely.geometry import MultiPolygon as ShpMultiPolygon\r\n    from shapely.geometry import GeometryCollection as ShpGeometryCollection\r\n    from shapely.geometry.base import BaseGeometry\r\n    from shapely import get_exterior_ring\r\nexcept ImportError:\r\n    print(\"\\n Please install Shapely package!\")\r\n\r\ndef get_exterior_recursive(geom):\r\n    results = []\r\n    \r\n    if hasattr(geom, 'geoms'):\r\n        for sub_geom in geom.geoms:\r\n            results.extend(get_exterior_recursive(sub_geom))\r\n            \r\n    elif isinstance(geom, ShpPolygon):\r\n        results.append(get_exterior_ring(geom))\r\n        \r\n    return results\r\n\r\ndef get_shapely_Exteriorboundary(input_data, return_individual=False):\r\n    if isinstance(input_data, list):\r\n        return [get_shapely_Exteriorboundary(item, return_individual) for item in input_data]\r\n    \r\n    elif isinstance(input_data, BaseGeometry):\r\n        boundaries = get_exterior_recursive(input_data)\r\n        \r\n        if not boundaries:\r\n            return None\r\n            \r\n        if len(boundaries) == 1 and not return_individual:\r\n            return boundaries[0]\r\n            \r\n        return boundaries\r\n\r\n    return None\r\n\r\nif 'IN' in locals():\r\n    shapely_input = IN[0]\r\n    indiv_mode = IN[1] if (len(IN) > 1 and IN[1] is not None) else False\r\n    \r\n    OUT = get_shapely_Exteriorboundary(shapely_input, indiv_mode)",
      "Engine": "CPython3",
