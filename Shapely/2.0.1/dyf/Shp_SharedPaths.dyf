      "Replication": "Disabled",
      "Description": "Un paramètre de fonction, utiliser avec des noeuds personnalisés.\r\n\r\nVous pouvez spécifier le type et la valeur par défaut du paramètre. Par exemple,\r\n\r\nentrée: var[]..[]\r\nvaleur: bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Shapely 2.0.1\r\n# Durmus Bayram\r\nimport clr\r\n\r\ntry:\r\n    from shapely.geometry.base import BaseGeometry\r\n    from shapely.ops import shared_paths\r\n    from shapely.geometry import (\r\n        GeometryCollection, LineString, MultiLineString, \r\n        Polygon, MultiPolygon, Point, MultiPoint\r\n    )\r\nexcept ImportError:\r\n    pass\r\n\r\ndef prepare_geometry(g):\r\n    if not isinstance(g, BaseGeometry):\r\n        return None\r\n    \r\n    if g.geom_type in ['LineString', 'MultiLineString']:\r\n        return g\r\n    \r\n    if g.geom_type in ['Polygon', 'MultiPolygon']:\r\n        return g.boundary\r\n    \r\n    if g.geom_type == 'GeometryCollection':\r\n        lines = [prepare_geometry(sub) for sub in g.geoms if prepare_geometry(sub) is not None]\r\n        if lines:\r\n            return MultiLineString(lines)\r\n            \r\n    return None\r\n\r\ndef safe_shared_paths(g1, g2):\r\n    try:\r\n        geom1 = prepare_geometry(g1)\r\n        geom2 = prepare_geometry(g2)\r\n\r\n        if geom1 is not None and geom2 is not None:\r\n            try:\r\n                return shared_paths(geom1, geom2)\r\n            except:\r\n                return GeometryCollection() \r\n        return GeometryCollection() \r\n    except:\r\n        return GeometryCollection()\r\n\r\ndef process_lacing(a, b):\r\n    if not isinstance(a, list) and not isinstance(b, list):\r\n        return safe_shared_paths(a, b)\r\n    \r\n    list_a = a if isinstance(a, list) else [a]\r\n    list_b = b if isinstance(b, list) else [b]\r\n    \r\n    max_len = max(len(list_a), len(list_b))\r\n    results = []\r\n    \r\n    for i in range(max_len):\r\n        item_a = list_a[i] if i < len(list_a) else list_a[-1]\r\n        item_b = list_b[i] if i < len(list_b) else list_b[-1]\r\n        \r\n        if isinstance(item_a, list) or isinstance(item_b, list):\r\n            results.append(process_lacing(item_a, item_b))\r\n        else:\r\n            results.append(safe_shared_paths(item_a, item_b))\r\n            \r\n    return results\r\n\r\nif 'IN' in locals():\r\n    input_a = IN[0]\r\n    input_b = IN[1] if len(IN) > 1 else None\r\n    \r\n    if input_a is not None and input_b is not None:\r\n        OUT = process_lacing(input_a, input_b)\r\n    else:\r\n        OUT = None",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "892371bd1926403c91eca563240984b3",
